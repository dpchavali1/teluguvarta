# TTE — The Telugu Edit — local environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Database (T03 adds schema; T02 just needs a reachable Postgres) ---
DATABASE_URL=postgresql+psycopg://teluguvarta:teluguvarta@localhost:5432/teluguvarta

# --- API base URL for browser-side apps (apps/admin, apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Canonical public site URL (T14): PUBLIC_WEB_URL is read server-side by
# the API to build share-meta canonical URLs; NEXT_PUBLIC_WEB_URL is the same
# value read by apps/web (server + client) for sitemap/canonical/share links.
# Keep both in sync. ---
PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# --- apps/mobile (T15): same API/site origins, read via Expo's EXPO_PUBLIC_
# prefix (Metro only inlines env vars with this exact prefix) instead of
# NEXT_PUBLIC_. Point EXPO_PUBLIC_API_URL at a LAN IP (not localhost) when
# testing on a physical device or the Expo Go app. ---
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# --- Admin authentication (T05) ---
# Signs short-lived admin JWTs — generate a real random value per environment
# (e.g. `openssl rand -hex 32`), never reuse this across environments.
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRE_MINUTES=30
# Seeded by infra/scripts/seed.py so there's an admin account to log in with
# locally; set a real password before running seed against anything shared.
ADMIN_SEED_EMAIL=admin@teluguvarta.local
ADMIN_SEED_PASSWORD=

# --- AI provider gateway (apps/api/app/ai — see ADR-001) ---
# OpenAI is primary (relevance/summary/why-matters/translation default leg,
# dedup-escalation embeddings); Anthropic is secondary (translation's
# second-provider escalation leg, sensitive-content validation). Only
# apps/api/app/ai/providers/*.py may read these — no other file may import
# the openai/anthropic SDKs (enforced by a CI grep check).
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=

# --- X official-account adapter (X2 — docs/tickets/X2.md) ---
# Official X API v2 bearer token for GET /2/users/{id}/tweets
# (app/x/client.py). Never used for scraping x.com: if unset, the
# x_official_account_fetch job fails closed (circuit breaker + backoff)
# instead of falling back to an unofficial data path (NON_NEGOTIABLES #14).
X_API_BEARER_TOKEN=
# Optional cost-per-post estimate + monthly budget guard for the X API,
# same pattern as MONTHLY_AI_BUDGET_USD below — blank means no guardrail
# (see app/x/budget.py).
X_API_COST_PER_POST_USD=
MONTHLY_X_API_BUDGET_USD=

# --- Budgets and kill switches (NON_NEGOTIABLES: AI cost telemetry + auto-publish gates) ---
# Left blank here (dev default: no budget = no guardrail, see
# app/ai/budget.py::is_over_monthly_budget). ADR-007 sets the production
# pilot-phase values: MONTHLY_AI_BUDGET_USD=150, DAILY_AI_ALERT_USD=10,
# MONTHLY_INFRA_BUDGET_USD=200 — set those in the real production
# environment's secret store, not committed here.
MONTHLY_AI_BUDGET_USD=
MONTHLY_INFRA_BUDGET_USD=
DAILY_AI_ALERT_USD=
AUTO_PUBLISH_DISABLE_ON_BUDGET_BREACH=true
AUTO_PUBLISH_GLOBAL=false
AUTO_PUBLISH_CATEGORY_IMMIGRATION=false

# --- Feature flags ---
AI_TRANSLATION_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false
# T11 §15: whether a P1 (high-importance/urgency) story requires human
# review before publish, same as P0 always does. Default true.
AI_REVIEW_P1_STORIES=true

# --- Push notifications (FCM + APNs via Expo/React Native tooling) ---
FCM_SERVER_KEY=
EXPO_PUSH_ACCESS_TOKEN=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# --- Object storage (S3-compatible; images/exports/log artifacts) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# --- Monitoring (T18) ---
SENTRY_DSN=
# Shared client-side DSN for apps/web, apps/admin, apps/mobile error
# tracking (browser/RN builds can't read SENTRY_DSN directly since it
# isn't NEXT_PUBLIC_-prefixed / EXPO_PUBLIC_-prefixed).
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
# Generic incoming-webhook URL (Slack "Incoming Webhook" or any endpoint
# that accepts {"text": "..."}) alerts are POSTed to, in addition to being
# logged. No new infra — pick whatever webhook your team already has.
ALERT_WEBHOOK_URL=
# Analytics (§17 core events, T18). apps/web and apps/mobile both post
# events to POST /v1/events; app/analytics.py is the one place that
# forwards them on to PostHog (or logs only, if unset) — no per-app
# PostHog SDK/key needed.
POSTHOG_API_KEY=
POSTHOG_HOST=
