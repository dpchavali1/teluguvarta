# Telugu Global — local environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Database (T03 adds schema; T02 just needs a reachable Postgres) ---
DATABASE_URL=postgresql+psycopg://teluguvarta:teluguvarta@localhost:5432/teluguvarta

# --- API base URL for browser-side apps (apps/admin, later apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Admin authentication (T05) ---
# Signs short-lived admin JWTs — generate a real random value per environment
# (e.g. `openssl rand -hex 32`), never reuse this across environments.
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRE_MINUTES=30
# Seeded by infra/scripts/seed.py so there's an admin account to log in with
# locally; set a real password before running seed against anything shared.
ADMIN_SEED_EMAIL=admin@teluguvarta.local
ADMIN_SEED_PASSWORD=

# --- AI provider gateway (packages/ai) ---
# Provider not yet selected — see ADR-001 (not started). Domain/app code must
# never call a provider SDK directly; only packages/ai reads this.
AI_PROVIDER_API_KEY=

# --- Budgets and kill switches (NON_NEGOTIABLES: AI cost telemetry + auto-publish gates) ---
MONTHLY_AI_BUDGET_USD=
MONTHLY_INFRA_BUDGET_USD=
DAILY_AI_ALERT_USD=
AUTO_PUBLISH_DISABLE_ON_BUDGET_BREACH=true
AUTO_PUBLISH_GLOBAL=false
AUTO_PUBLISH_CATEGORY_IMMIGRATION=false

# --- Feature flags ---
AI_TRANSLATION_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false

# --- Push notifications (FCM + APNs via Expo/React Native tooling) ---
FCM_SERVER_KEY=
EXPO_PUSH_ACCESS_TOKEN=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# --- Object storage (S3-compatible; images/exports/log artifacts) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# --- Monitoring ---
SENTRY_DSN=
