{
  "name": "teluguvarta",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "tokens:generate": "pnpm --filter @teluguvarta/design-tokens run generate",
    "tokens:check": "pnpm --filter @teluguvarta/design-tokens run check",
    "tokens:contrast": "pnpm --filter @teluguvarta/design-tokens run contrast:check",
    "migrate": "bash infra/scripts/migrate.sh",
    "seed": "apps/api/.venv/bin/python infra/scripts/seed.py",
    "contracts:generate": "bash infra/scripts/generate_contracts.sh"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "js-yaml": ">=4.3.2"
    }
  }
}
